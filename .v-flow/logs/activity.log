import re
d={
"Nền tảng":"DB trống áp dụng schema + migration sạch và dữ liệu account A không lộ sang account B (AC-01)",
"UC-01.main":"Khách nhắn tin mới → agent gửi đúng một trả lời đã validate, restart không gửi trùng (AC-02, AC-03)",
"UC-02.main":"Operator takeover, gửi tin tay rồi release; trong lúc takeover agent không tự trả lời (AC-08, AC-09)",
"UC-03.main":"Khách im lặng đủ ngưỡng nhận đúng một tin follow-up (AC-11)",
"UC-04.main":"Operator đăng nhập, start/pause/resume agent và thấy trạng thái cập nhật qua WebSocket (AC-13)",
"UC-05.main":"Operator tạo đơn và đơn hiển thị theo đúng account (AC-14)",
"UC-01-E1":"Tin placeholder → câu xác nhận đúng ngôn ngữ; yêu cầu người thật → escalation; LLM lỗi → không gửi nội dung chưa kiểm (AC-04, AC-05, AC-06)",
"UC-01-A1":"Khách hỏi giá/tồn kho → trả lời khớp dữ liệu sản phẩm thật (AC-07)",
"UC-02-E1":"Operator không quyền nhận 403 và trạng thái hội thoại không đổi (AC-10)",
"UC-03-E1":"Cùng một lần im lặng, follow-up không lặp; takeover/ngoài giờ thì hoãn (AC-11)",
"UC-04-E1":"Sai mật khẩu, vượt quota hoặc JWT Cloudflare sai đều bị từ chối (AC-12)",
"UC-05-E1":"Webhook Sheet lỗi nhưng đơn vẫn được lưu và thao tác không bị chặn (AC-14)",
}
s=open("main-first.yaml").read()
def r(m):
    k=m.group(1).split(" — ")[0]
    return "demo: '"+d[k]+"'"
s=re.sub(r"demo: 'TODO: ([^']*)'",r,s)
open("main-first.yaml","w").write(s)
PY
