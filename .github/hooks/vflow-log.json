{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "v-flow log --hook copilot --event postToolUse"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "v-flow log --hook copilot --event agentStop"
      }
    ],
